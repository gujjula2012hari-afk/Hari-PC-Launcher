<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://android.com"
    xmlns:app="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B192C">

    <androidx.media3.ui.PlayerView
        android:id="@+id/videoWallpaperView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="zoom" />

    <LinearLayout
        android:id="@+id/desktopIcons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/btnThisPC"
            android:layout_width="85dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#33000000"
            android:gravity="center"
            android:padding="8dp"
            android:text="💻\nThis PC"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnWallpaper"
            android:layout_width="85dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#33000000"
            android:gravity="center"
            android:padding="8dp"
            android:text="🎬\n4K Video"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnTaskManager"
            android:layout_width="85dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#33000000"
            android:gravity="center"
            android:padding="8dp"
            android:text="📊\nTask Mgr"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnControlPanel"
            android:layout_width="85dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="#33000000"
            android:gravity="center"
            android:padding="8dp"
            android:text="⚙️\nSettings"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRecycleBin"
            android:layout_width="85dp"
            android:layout_height="wrap_content"
            android:background="#33000000"
            android:gravity="center"
            android:padding="8dp"
            android:text="🗑️\nRecycle Bin"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pcWindow"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:layout_centerInParent="true"
        android:layout_margin="20dp"
        android:background="#E61E1E2E"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#2B2D42"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <TextView
                android:id="@+id/windowTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Window"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCloseWindow"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="#E63946"
                android:gravity="center"
                android:text="X"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <TextView
                android:id="@+id/windowContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6dp"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/startMenu"
        android:layout_width="match_parent"
        android:layout_height="450dp"
        android:layout_above="@+id/taskbar"
        android:layout_margin="12dp"
        android:background="#F0161B22"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Hari PC Launcher - All Apps"
            android:textColor="#58A6FF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/appListView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#30363D"
            android:dividerHeight="1dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/taskbar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:background="#D90D1117"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <TextView
            android:id="@+id/btnStart"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="#1F6FEB"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="⊞ Start"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnQuickCalc"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:background="#21262D"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="🧮 Calc"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/btnQuickNote"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="#21262D"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:text="📝 Note"
            android:textColor="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/txtClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="12:00 PM"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
              
